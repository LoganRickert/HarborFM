# HarborFM origin (or full /api base), e.g. https://podcast.example.com
HARBORFM_URL=https://your-harborfm.example.com
# From Settings > Workers (path token or full Worker connection URL)
WORKER_WS_PATH=
WORKER_SECRET=
WORKER_NAME=pc-worker
# Default compose: http://whisper:9000. With docker-compose.override.yml: your ASR URL
# (e.g. http://host.docker.internal:9000 if Whisper is published on the host).
WHISPER_ASR_URL=http://whisper:9000
WORKER_WORK_DIR=/work
# Upload chunk size in MiB (default 50). Keep under HarborFM / nginx body limits.
# WORKER_UPLOAD_CHUNK_MB=50
# WebSocket keepalive interval (ms). Default 25000.
# WORKER_WS_HEARTBEAT_MS=25000
